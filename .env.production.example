# Turo Toll Tracking System - Production Configuration
# Copy this file to .env and configure for your environment

# =======================
# CORE APPLICATION CONFIG
# =======================
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# =======================
# SECURITY CONFIGURATION
# =======================
# Generate with: openssl rand -hex 32
SESSION_SECRET=your_secure_32_character_session_secret_here_1234567890
ENCRYPTION_MASTER_KEY=your_secure_32_character_encryption_key_here_1234567890

# =======================
# DATABASE CONFIGURATION
# =======================
# SQLite is optimized for production use
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=5
DB_POOL_ACQUIRE_TIMEOUT=10000
DB_POOL_IDLE_TIMEOUT=300000

# =======================
# REDIS CONFIGURATION
# =======================
# Redis URL for caching and job queues
REDIS_URL=redis://localhost:6379
# Alternative for Redis with auth:
# REDIS_URL=redis://username:password@host:port/database

# Cache configuration
CACHE_DEFAULT_TTL=300
CACHE_L1_TTL=60

# =======================
# PERFORMANCE MONITORING
# =======================
PERFORMANCE_MONITORING=true
PERFORMANCE_SAMPLE_RATE=1.0
SLOW_QUERY_THRESHOLD=1000

# =======================
# WEBSOCKET CONFIGURATION
# =======================
WS_MAX_CONNECTIONS=1000
WS_MAX_CONNECTIONS_PER_IP=10
WS_HEARTBEAT_INTERVAL=30000
WS_CONNECTION_TIMEOUT=30000

# =======================
# SCRAPER CONFIGURATION
# =======================
SCRAPER_MAX_BROWSERS=3
SCRAPER_MIN_BROWSERS=1
SCRAPER_HEADLESS=true
SCRAPER_BROWSER_TIMEOUT=300000
SCRAPER_PAGE_TIMEOUT=60000

# =======================
# JOB QUEUE CONFIGURATION
# =======================
# Job queue concurrency limits
QUEUE_TOLL_SCRAPING_CONCURRENCY=2
QUEUE_TOLL_PROCESSING_CONCURRENCY=5
QUEUE_NOTIFICATIONS_CONCURRENCY=3
QUEUE_REPORTING_CONCURRENCY=1

# Job retry configuration
JOB_MAX_ATTEMPTS=3
JOB_RETRY_DELAY=2000

# =======================
# EMAIL CONFIGURATION
# =======================
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@domain.com
SMTP_PASS=your-email-password
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Turo Toll Tracker

# =======================
# MONITORING & ALERTING
# =======================
# Health check intervals (milliseconds)
HEALTH_CHECK_INTERVAL=60000
METRICS_COLLECTION_INTERVAL=30000

# Alert thresholds
ALERT_MEMORY_THRESHOLD=0.9
ALERT_RESPONSE_TIME_THRESHOLD=2000
ALERT_ERROR_RATE_THRESHOLD=0.05
ALERT_SLOW_QUERY_RATE_THRESHOLD=0.1

# =======================
# RATE LIMITING
# =======================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# API specific rate limits
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=1000

# =======================
# FILE UPLOAD LIMITS
# =======================
MAX_FILE_SIZE=10485760
MAX_FILES_PER_REQUEST=5

# =======================
# BACKUP CONFIGURATION
# =======================
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_LOCATION=./backups

# =======================
# INTEGRATION SETTINGS
# =======================
# Turo API Configuration (if available)
TURO_API_URL=https://api.turo.com/v1
TURO_API_KEY=your-turo-api-key-here

# EZ-Pass Integration
EZPASS_SCRAPE_INTERVAL=3600000
EZPASS_MAX_CONCURRENT_SCRAPES=2

# =======================
# ANALYTICS & REPORTING
# =======================
ANALYTICS_DATA_RETENTION_DAYS=365
REPORT_GENERATION_TIMEOUT=300000
AUTOMATED_REPORTS_ENABLED=true

# =======================
# DEVELOPMENT OVERRIDES
# =======================
# These settings can be overridden in development
# SCRAPER_HEADLESS=false
# LOG_LEVEL=debug
# PERFORMANCE_SAMPLE_RATE=0.1