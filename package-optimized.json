{
  "name": "turo-tolls",
  "version": "2.0.0",
  "description": "Production-optimized automated toll tracking and billing system for Turo hosts",
  "main": "server-optimized.js",
  "scripts": {
    "start": "node server.js",
    "start:optimized": "node server-optimized.js",
    "dev": "NODE_ENV=development node server-optimized.js",
    "dev:debug": "NODE_ENV=development LOG_LEVEL=debug node server-optimized.js",
    "production": "NODE_ENV=production node server-optimized.js",
    "test:health": "curl -s http://localhost:3000/health/full | jq",
    "test:metrics": "curl -s http://localhost:3000/status | jq",
    "cache:warm": "curl -X POST http://localhost:3000/api/dashboard/cache/warm",
    "cache:clear": "curl -X POST http://localhost:3000/api/dashboard/cache/invalidate",
    "db:optimize": "node -e \"const { db } = require('./config/database'); db.exec('VACUUM; ANALYZE;', console.log);\"",
    "logs:tail": "tail -f logs/combined.log",
    "logs:error": "tail -f logs/error.log",
    "pm2:start": "pm2 start server-optimized.js --name turo-toll-tracker --instances 1",
    "pm2:stop": "pm2 stop turo-toll-tracker",
    "pm2:restart": "pm2 restart turo-toll-tracker",
    "pm2:logs": "pm2 logs turo-toll-tracker"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "bull": "^4.16.5",
    "cookie-parser": "^1.4.6",
    "csurf": "^1.11.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "express-session": "^1.17.3",
    "handlebars": "^4.7.8",
    "helmet": "^6.1.5",
    "ioredis": "^5.7.0",
    "joi": "^17.9.2",
    "multer": "^1.4.4",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.5",
    "puppeteer": "^24.16.0",
    "redis": "^5.8.0",
    "sqlite3": "^5.1.6",
    "uuid": "^11.1.0",
    "validator": "^13.9.0",
    "winston": "^3.17.0",
    "ws": "^8.18.3"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "turo",
    "toll-tracking",
    "automation",
    "billing",
    "ezpass",
    "performance",
    "scalability"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/turo-tolls.git"
  },
  "license": "MIT",
  "author": "Your Name <your.email@domain.com>",
  "homepage": "https://github.com/yourusername/turo-tolls#readme",
  "bugs": {
    "url": "https://github.com/yourusername/turo-tolls/issues"
  }
}