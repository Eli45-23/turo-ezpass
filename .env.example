# Turo Toll Tracker Environment Configuration

# Security Keys (REQUIRED)
SESSION_SECRET=your-super-secret-session-key-min-32-chars-long
ENCRYPTION_MASTER_KEY=your-super-secret-encryption-key-min-32-chars-long

# Application Settings
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# Email Configuration (Primary Provider)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@turotolls.com

# Backup Email Provider (Optional but recommended)
BACKUP_EMAIL_HOST=smtp.mailgun.org
BACKUP_EMAIL_PORT=587
BACKUP_EMAIL_USER=postmaster@your-domain.mailgun.org
BACKUP_EMAIL_PASSWORD=your-mailgun-api-key

# WebSocket Configuration
WS_MAX_CONNECTIONS=5

# Database Configuration (SQLite is default)
# No additional configuration needed for SQLite

# Notification Settings
NOTIFICATION_BATCH_SIZE=5
NOTIFICATION_DELAY_MS=1000

# Toll Provider Settings (for future E-ZPass integration)
# EZPASS_USERNAME=your-ezpass-username
# EZPASS_PASSWORD=your-ezpass-password

# Security Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info