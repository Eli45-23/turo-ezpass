# Turo Toll Tracker - Production Environment Template
# Copy this to .env for production deployment
# IMPORTANT: Replace ALL placeholder values with real secure values

# =======================
# CORE APPLICATION CONFIG
# =======================
NODE_ENV=production
PORT=3000
BASE_URL=https://yourdomain.com

# =======================
# SECURITY CONFIGURATION (REQUIRED)
# =======================
# Generate these: openssl rand -hex 32
SESSION_SECRET=your_secure_32_character_session_secret_here_1234567890abcdef
ENCRYPTION_MASTER_KEY=your_secure_32_character_encryption_key_here_1234567890abcdef

# =======================
# DATABASE CONFIGURATION
# =======================
# Optional: Custom database path (defaults to ./turo_tolls.db)
# DATABASE_PATH=/path/to/your/database/turo_tolls.db

# =======================
# WEBSOCKET CONFIGURATION
# =======================
WS_MAX_CONNECTIONS=1000
WS_MAX_CONNECTIONS_PER_IP=10

# =======================
# RATE LIMITING (Production values)
# =======================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =======================
# EMAIL CONFIGURATION (Optional but recommended)
# =======================
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_USER=your-email@domain.com
EMAIL_PASSWORD=your-email-password
EMAIL_FROM=noreply@yourdomain.com

# =======================
# LOGGING
# =======================
LOG_LEVEL=info

# =======================
# PERFORMANCE MONITORING
# =======================
PERFORMANCE_MONITORING=true
PERFORMANCE_SAMPLE_RATE=1.0

# =======================
# FILE UPLOAD LIMITS
# =======================
MAX_FILE_SIZE=10485760
MAX_FILES_PER_REQUEST=5

# =======================
# BACKUP CONFIGURATION
# =======================
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_LOCATION=./backups

# =======================
# NOTIFICATION SETTINGS
# =======================
NOTIFICATION_BATCH_SIZE=5
NOTIFICATION_DELAY_MS=1000