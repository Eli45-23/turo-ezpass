{
  "name": "turo-toll-tracker",
  "version": "1.0.0",
  "description": "A comprehensive toll tracking and management system for Turo hosts",
  "main": "server.js",
  "scripts": {
    "start": "NODE_ENV=production node server.js",
    "dev": "NODE_ENV=development node server.js",
    "test": "echo \"Tests coming soon\" && exit 0",
    "tunnel": "npx ngrok http 3000",
    "share": "npm run dev & npm run tunnel",
    "build": "echo \"No build step required for Node.js app\"",
    "prestart": "echo \"Starting Turo Toll Tracker...\"",
    "postinstall": "echo \"Installation complete. Run 'npm run dev' to start development server.\""
  },
  "keywords": [
    "turo",
    "toll",
    "tracking",
    "ezpass",
    "hosting",
    "automation"
  ],
  "author": "Eli Colon",
